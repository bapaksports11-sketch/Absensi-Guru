{
  "name": "Absensi Guru",
  "short_name": "Absensi Guru",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#1a73e8",
  "theme_color": "#1a73e8",
  "icons": [
    {"src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any"},
    {"src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any"},
    {"src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable"}
  ]
}

const CACHE='absensi-guru-v1';
const SHELL=['./','./index.html','./manifest.json','./icons/icon-192.png','./icons/icon-512.png'];
self.addEventListener('install',e=>{e.waitUntil(caches.open(CACHE).then(c=>c.addAll(SHELL)));self.skipWaiting();});
self.addEventListener('activate',e=>{e.waitUntil(caches.keys().then(k=>Promise.all(k.filter(x=>x!==CACHE).map(x=>caches.delete(x)))));self.clients.claim();});
self.addEventListener('fetch',e=>{
  const u=new URL(e.request.url);
  if(u.origin!==location.origin) return; // data Apps Script selalu online
  e.respondWith(fetch(e.request).catch(()=>caches.match(e.request)));
});

<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#1a73e8">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-title" content="Absensi Guru">
<link rel="manifest" href="manifest.json">
<link rel="icon" href="icons/icon-192.png">
<link rel="apple-touch-icon" href="icons/icon-192.png">
<title>Absensi Guru</title>
<style>
  html,body{margin:0;height:100%;background:#fff;font-family:system-ui,sans-serif}
  iframe{position:fixed;inset:0;width:100%;height:100%;border:0}
  #splash{position:fixed;inset:0;background:#1a73e8;color:#fff;display:flex;flex-direction:column;
    align-items:center;justify-content:center;gap:16px;transition:opacity .4s;z-index:2}
  #splash img{width:96px;height:96px;border-radius:22px}
  #splash.hide{opacity:0;pointer-events:none}
  .spin{width:28px;height:28px;border:3px solid rgba(255,255,255,.35);border-top-color:#fff;border-radius:50%;animation:s 1s linear infinite}
  @keyframes s{to{transform:rotate(360deg)}}
  #fallback{display:none;background:#fff;color:#1a73e8;padding:10px 18px;border-radius:8px;text-decoration:none;font-weight:600}
</style>
</head>
<body>
<div id="splash">
  <img src="icons/icon-192.png" alt="">
  <strong>Absensi Guru</strong>
  <div class="spin" id="spin"></div>
  <a id="fallback" href="https://script.google.com/macros/s/AKfycbze5qbiDv6s9lupgSnRG7dlA8Lfn7rV1rhtcJ9fzkag0SpO_aQuPQMd__nmF9G7K5GZ/exec">Buka langsung</a>
</div>
<iframe id="app" src="https://script.google.com/macros/s/AKfycbze5qbiDv6s9lupgSnRG7dlA8Lfn7rV1rhtcJ9fzkag0SpO_aQuPQMd__nmF9G7K5GZ/exec" allow="geolocation; camera; microphone" title="Absensi Guru"></iframe>
<script>
  const splash=document.getElementById('splash');
  document.getElementById('app').addEventListener('load',()=>splash.classList.add('hide'));
  setTimeout(()=>{ if(!splash.classList.contains('hide')){
    document.getElementById('spin').style.display='none';
    document.getElementById('fallback').style.display='inline-block';}},10000);
  if('serviceWorker' in navigator) navigator.serviceWorker.register('sw.js').catch(()=>{});
</script>
</body>
</html>
